# The program declares the contract and names no implementation. Whoever builds
# it appends the implementation: an implementation's continuous integration
# appends itself as a path dependency, and the specification's own appends a
# published one. That the implementation is named here and not in the source is
# the arrangement this example exists to show.
[package]
name    = "portable"
version = "0.1.0"

[dependencies]
openkal = "0.3.0"
